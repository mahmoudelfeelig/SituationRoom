{
	auto_https off
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	@uncached not path /assets/* /source/*
	header @uncached Cache-Control "public, no-cache, max-age=0, must-revalidate, no-transform"

	@existingAssets {
		path /assets/*
		file
	}
	handle @existingAssets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@missingAssets {
		path /assets/*
		not file
	}
	handle @missingAssets {
		header Cache-Control "no-store"
		respond 404
	}

	@existingSource {
		path /source/*
		file
	}
	handle @existingSource {
		header Cache-Control "public, max-age=300, must-revalidate"
		header Content-Disposition "attachment"
		file_server
	}

	@missingSource {
		path /source/*
		not file
	}
	handle @missingSource {
		header Cache-Control "no-store"
		respond 404
	}

	@api path /api /api/*
	respond @api 404

	@spa {
		method GET HEAD
		header Accept *text/html*
		not path /assets/* /source/* /api /api/*
		not file
	}
	rewrite @spa /index.html

	file_server
}
